# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Admin seed (used by prisma db seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Supabase Storage (upload to product-images bucket)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP for contact form emails (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Contact form notifications. All four SMTP_* vars plus both of these must be
# set or no email is sent — the submission is still saved to ContactMessage and
# shows up in /admin/messages, but nobody is notified. There is deliberately no
# default: a fallback would silently route customer PII to whatever address was
# hardcoded.
#
# CONTACT_INBOX_EMAIL is where submissions land.
# CONTACT_FROM_EMAIL is the From: header. Using Gmail SMTP, it MUST match
# SMTP_USER — Gmail only lets you send as the authenticated account or a
# verified alias, and rewrites anything else.
CONTACT_INBOX_EMAIL=you@example.com
CONTACT_FROM_EMAIL="Reverie Revival <you@example.com>"
